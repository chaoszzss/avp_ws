<launch>
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find avp_mapping)/launch/geometric_mapping.rviz" />

    <node name="avp_mapping" pkg="avp_mapping" type="geometric_mapping_node" output="screen">
        <param name="auto_run" type="bool" value="true" />
        <param name="show_img" type="bool" value="true" />
    </node>
</launch>
